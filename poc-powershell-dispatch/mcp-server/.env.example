# Base URL of the Asset-Terminator intake Function App (no trailing slash).
AT_FUNCTION_BASE_URL=https://attdisp-func-api-dev.azurewebsites.net

# Function App host key (x-functions-key), valid for both API endpoints.
# Retrieve the "default" host key with:
#   az functionapp keys list -g ASSET-TERMINATOR-DISPATCH-RG \
#     -n attdisp-func-api-dev --query functionKeys.default -o tsv
AT_FUNCTION_KEY=

# Optional per-request timeout in milliseconds (default 30000).
AT_FUNCTION_TIMEOUT_MS=30000
