# Base URL of the Asset-Terminator intake Function App (no trailing slash).
AT_FUNCTION_BASE_URL=https://attdisp-func-api-dev.azurewebsites.net

# Intake function key (x-functions-key). Retrieve with:
#   az functionapp function keys list -g ASSET-TERMINATOR-DISPATCH-RG \
#     -n attdisp-func-api-dev --function-name WipeIntake --query default -o tsv
AT_FUNCTION_KEY=

# Optional per-request timeout in milliseconds (default 30000).
AT_FUNCTION_TIMEOUT_MS=30000
