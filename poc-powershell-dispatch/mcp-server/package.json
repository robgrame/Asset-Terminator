{
  "name": "asset-terminator-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Functions remote MCP server exposing the Asset-Terminator disposal API as tools.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
