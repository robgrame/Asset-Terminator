    "test": "npm run build && node --test test/*.test.mjs",
    "watch": "tsc --watch"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/functions": "^4.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
