{
  "version": "2.0",
  "managedDependency": { "enabled": false },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
      "clientRetryOptions": {
        "mode": "exponential",
        "tryTimeout": "00:00:05",
        "delay": "00:00:00.80",
        "maxDelay": "00:00:05",
        "maxRetries": 3
      },
      "prefetchCount": 0,
      "maxAutoLockRenewalDuration": "00:05:00",
      "maxConcurrentSessions": 16,
      "sessionIdleTimeout": "00:00:05"
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request;Event;Exception" }
    }
  }
}
